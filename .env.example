# Django
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_WSGI_MODULE=config.wsgi:application
DJANGO_ASGI_MODULE=config.asgi:application
DJANGO_SECRET_KEY=change-me
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
PORT=8000

# Database
POSTGRES_DB=contentgen
POSTGRES_USER=contentgen
POSTGRES_PASSWORD=contentgen
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://contentgen:contentgen@db:5432/contentgen
# Optional external DB example:
# DATABASE_URL=postgresql://username:password@host/database?sslmode=require

# Redis / Celery
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
CELERY_APP=config.celery:app
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CELERY_LOGLEVEL=info

# OpenAI
OPENAI_API_KEY=sk-your-key
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_REQUEST_TIMEOUT=180

# Storage
MEDIA_ROOT=/app/media
STATIC_ROOT=/app/staticfiles
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=

# Runtime
RUN_DB_MIGRATIONS=1
COLLECT_STATIC=1
WAIT_FOR_DB=1
WAIT_FOR_REDIS=1
DB_WAIT_TIMEOUT=60
REDIS_WAIT_TIMEOUT=60
HEALTHCHECK_PATH=/health/
WEB_CONCURRENCY=2
GUNICORN_TIMEOUT=120
GUNICORN_CMD_ARGS=--reload --access-logfile - --error-logfile -
